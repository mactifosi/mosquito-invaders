{
  "name": "mosquito-invaders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:native": "CAP_BUILD=1 vite build && cap sync ios",
    "ios": "npm run build:native && open 'ios/App/Caddora Games.xcodeproj'",
    "archive": "npm run build:native && ./scripts/archive.sh",
    "bump": "./scripts/bump-build.sh",
    "upload": "./scripts/upload-testflight.sh",
    "release": "npm run archive && npm run upload && npm run bump",
    "test": "node test/game.test.mjs && node test/piranha.test.mjs && node test/skimmer.test.mjs",
    "device": "npm run build:native && ./scripts/device.sh",
    "layouts": "node scripts/render-layouts.mjs piranha-layouts.png"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "esbuild": "^0.21.5"
  }
}
